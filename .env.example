LINK_INSTAGRAM_URL="https://instagram.com/7xpatrimonial"
LINK_TIKTOK_URL="https://tiktok.com/@7xpatrimonial"
LINK_WHATSAPP_URL="https://wa.me/5511999997777"
LINK_WHATSAPP_URL_2=""

# ── Integração API Tecimob ───────────────────────────────────────────────
USE_TECIMOB_API=false
TECIMOB_API_TOKEN=""

 # ── Cloudflare R2 (Storage de Imagens) ──
R2_ACCOUNT_ID=seu_account_id_aqui
